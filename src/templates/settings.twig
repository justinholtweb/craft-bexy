{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks correct, Craft reports "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

{% set plugin = plugin ?? craft.app.plugins.getPlugin('bexy') %}
{% set auth = plugin.auth %}
{% set meta = plugin.meta %}
{% set commerceReady = craft.app.plugins.isPluginEnabled('commerce') %}
{% set connected = auth.isConnected() %}
{% set tokenSet = auth.getTokenSet() %}

{% set taxOptions = meta.getTaxOptions() %}
{% set accountOptions = meta.getAccountOptions() %}
{% set userOptions = meta.getUserOptions() %}

{% set taxCategoryOptions = [{ label: '— any —'|t('bexy'), value: '' }] %}
{% set orderStatusOptions = [{ label: '— none —'|t('bexy'), value: '' }] %}
{% set syncStatusOptions = [] %}
{% if commerceReady %}
    {% for category in craft.app.plugins.getPlugin('commerce').getTaxCategories().getAllTaxCategories() %}
        {% set taxCategoryOptions = taxCategoryOptions|merge([{ label: category.name, value: category.handle }]) %}
    {% endfor %}
    {% for status in craft.app.plugins.getPlugin('commerce').getOrderStatuses().getAllOrderStatuses() %}
        {% set orderStatusOptions = orderStatusOptions|merge([{ label: status.name, value: status.handle }]) %}
        {% set syncStatusOptions = syncStatusOptions|merge([{ label: status.name, value: status.handle }]) %}
    {% endfor %}
{% endif %}

{% if not commerceReady %}
    <div class="pane">
        <p class="error">{{ 'Craft Commerce is not installed or enabled. Bexy needs it to do anything.'|t('bexy') }}</p>
    </div>
{% endif %}

{# ------------------------------------------------------------------ #}
<h2>{{ 'Connection'|t('bexy') }}</h2>

<div class="pane">
    {% if connected %}
        <p>
            <span class="status green"></span>
            {% if tokenSet and tokenSet.companyName %}
                {{ 'Connected to {company}'|t('bexy', { company: tokenSet.companyName }) }}
                {%- if tokenSet.userEmail %} {{ '(as {email})'|t('bexy', { email: tokenSet.userEmail }) }}{% endif %}
            {% else %}
                {{ 'Connected to bexio.'|t('bexy') }}
            {% endif %}
        </p>
        {% if tokenSet and tokenSet.dateExpires %}
            <p class="light">
                {{ 'Access token expires {date}. Bexy refreshes it automatically.'|t('bexy', {
                    date: tokenSet.dateExpires|datetime('short')
                }) }}
            </p>
        {% endif %}
    {% else %}
        <p><span class="status"></span> {{ 'Not connected.'|t('bexy') }}</p>
    {% endif %}

    <div id="bexy-test-result" class="light" style="margin-top: 8px;"></div>

    <p style="margin-top: 12px;">
        <button type="button" class="btn" id="bexy-test">{{ 'Test connection'|t('bexy') }}</button>
        <button type="button" class="btn" id="bexy-refresh-meta">{{ 'Refresh lists from bexio'|t('bexy') }}</button>
        {% if connected %}
            <button type="button" class="btn" id="bexy-disconnect">{{ 'Disconnect'|t('bexy') }}</button>
        {% endif %}
    </p>
</div>

{{ forms.selectField({
    label: 'Authentication'|t('bexy'),
    instructions: 'A personal access token is one paste and starts working immediately — and bexio expires it 60 days after it was created, silently. The authorization code flow takes more setting up and then stays connected.'|t('bexy'),
    id: 'authMode',
    name: 'authMode',
    value: settings.authMode,
    options: [
        { label: 'OAuth 2.0 (recommended)'|t('bexy'), value: 'oauth' },
        { label: 'Personal access token'|t('bexy'), value: 'pat' },
    ],
    toggle: true,
    targetPrefix: 'auth-',
}) }}

<div id="auth-oauth" class="{{ settings.authMode == 'oauth' ? '' : 'hidden' }}">
    <div class="pane">
        <p>{{ 'Create an app at {link}, paste its credentials below, and register this redirect URL against it.'|t('bexy', {
            link: '<a href="https://developer.bexio.com" rel="noopener" target="_blank">developer.bexio.com</a>'
        })|raw }}</p>

        {{ forms.textField({
            label: 'Redirect URL'|t('bexy'),
            instructions: 'Copy this into the app’s “Allowed redirect URL” field in bexio.'|t('bexy'),
            id: 'bexy-redirect-uri',
            value: auth.getRedirectUri(),
            readonly: true,
            class: 'code',
        }) }}
    </div>

    {{ forms.autosuggestField({
        label: 'Client ID'|t('bexy'),
        id: 'clientId',
        name: 'clientId',
        value: settings.clientId,
        suggestEnvVars: true,
    }) }}

    {{ forms.autosuggestField({
        label: 'Client secret'|t('bexy'),
        instructions: 'Store this in an environment variable rather than in project config.'|t('bexy'),
        id: 'clientSecret',
        name: 'clientSecret',
        value: settings.clientSecret,
        suggestEnvVars: true,
    }) }}

    {% if not connected %}
        <div class="field">
            <p class="light">{{ 'Save the client ID and secret first, then connect.'|t('bexy') }}</p>
            <button type="button" class="btn submit" id="bexy-connect">{{ 'Connect to bexio'|t('bexy') }}</button>
        </div>
    {% endif %}
</div>

<div id="auth-pat" class="{{ settings.authMode == 'pat' ? '' : 'hidden' }}">
    {{ forms.autosuggestField({
        label: 'Personal access token'|t('bexy'),
        instructions: 'From {link}. bexio expires every token 60 days after it is issued, and will not warn you — put a reminder in the diary.'|t('bexy', {
            link: '<a href="https://developer.bexio.com/pat" rel="noopener" target="_blank">developer.bexio.com/pat</a>'
        }),
        id: 'personalAccessToken',
        name: 'personalAccessToken',
        value: settings.personalAccessToken,
        suggestEnvVars: true,
    }) }}
</div>

