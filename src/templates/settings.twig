{% js %}
(function() {
    var el = function(id) { return document.getElementById(id); };
    var result = el('bexy-test-result');

    // A secondary action on the settings screen cannot be its own <form> — Craft's settings form
    // already wraps this markup, and a nested form posts nothing at all. So one is built and
    // submitted from outside the DOM tree the settings form owns.
    var submitTo = function(action) {
        var form = document.createElement('form');
        form.method = 'post';
        form.action = '';

        var add = function(name, value) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = name;
            input.value = value;
            form.appendChild(input);
        };

        add('action', action);
        add(Craft.csrfTokenName, Craft.csrfTokenValue);

        document.body.appendChild(form);
        form.submit();
    };

    if (el('bexy-test')) {
        el('bexy-test').addEventListener('click', function() {
            result.textContent = Craft.t('bexy', 'Testing…');

            Craft.sendActionRequest('POST', 'bexy/settings/test', {})
                .then(function(response) {
                    var data = response.data || {};

                    if (data.ok) {
                        result.innerHTML = '<span class="status green"></span> ' + Craft.escapeHtml(data.message)
                            + (data.company ? ' — ' + Craft.escapeHtml(data.company) : '');
                    } else {
                        result.innerHTML = '<span class="status red"></span> ' + Craft.escapeHtml(data.message || '');
                    }
                })
                .catch(function(error) {
                    var data = (error && error.response && error.response.data) || {};
                    result.innerHTML = '<span class="status red"></span> '
                        + Craft.escapeHtml(data.message || Craft.t('bexy', 'Could not reach bexio.'));
                });
        });
    }

    if (el('bexy-connect')) {
        el('bexy-connect').addEventListener('click', function() { submitTo('bexy/settings/connect'); });
    }

    if (el('bexy-disconnect')) {
        el('bexy-disconnect').addEventListener('click', function() {
            if (confirm(Craft.t('bexy', 'Forget this bexio connection?'))) {
                submitTo('bexy/settings/disconnect');
            }
        });
    }

    if (el('bexy-refresh-meta')) {
        el('bexy-refresh-meta').addEventListener('click', function() { submitTo('bexy/settings/refresh-meta'); });
    }
})();
{% endjs %}
