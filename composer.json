{
    "name": "justinholtweb/craft-bexy",
    "description": "bexio integration for Craft Commerce \u2014 turn completed orders into bexio invoices or orders, push the payments that settle them, and pull bexio's verdict back into Commerce.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "craft-commerce",
        "commerce",
        "bexio",
        "accounting",
        "invoicing",
        "switzerland",
        "vat",
        "mwst"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0",
        "craftcms/commerce": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\bexy\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Bexy",
        "handle": "bexy",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-bexy/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-bexy/main/CHANGELOG.md",
        "class": "justinholtweb\\bexy\\Plugin"
    }
}
